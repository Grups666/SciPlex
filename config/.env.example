# LLM provider: Anthropic-compatible endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.sfkey.cn
ANTHROPIC_MODEL=glm-5.1
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-5.1
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.1
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.1

# Contact identity for polite academic API usage
RESEARCH_CONTACT_EMAIL=

# Literature providers
OPENALEX_BASE_URL=https://api.openalex.org
ENABLE_OPENALEX=true
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_BASE_URL=https://api.crossref.org

# arXiv: normally no API key required
ENABLE_ARXIV=false
ARXIV_BASE_URL=https://export.arxiv.org/api/query
ARXIV_USER_AGENT=AcademicResearch/0.1

# PubMed / NCBI E-utilities: API key optional but recommended for higher rate limits
NCBI_EUTILS_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_TOOL=AcademicResearch
NCBI_EMAIL=
NCBI_API_KEY=

# Zotero personal library
ENABLE_ZOTERO=true
ZOTERO_BASE_URL=https://api.zotero.org
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# Runtime
PROVIDER_TIMEOUT_SECONDS=20
RUNS_DIR=runs
CACHE_DIR=.cache/research-agent
LOG_LEVEL=INFO
