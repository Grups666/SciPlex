# Skill-level defaults for SciPlex.
# Project-level values in <workspace>/sciplex/config/ override these.

# Optional internal LLM provider: Anthropic-compatible endpoint.
# If omitted, SciPlex may fall back to the driver agent environment.
ANTHROPIC_API_KEY=<your-api-key>
ANTHROPIC_BASE_URL=<your-base-url>
ANTHROPIC_MODEL=<model-name>

# Optional task-specific model profiles. Leave blank to use ANTHROPIC_MODEL or
# the driver/default model for that task.
SCIPLEX_LLM_DEFAULT=<model-name>
SCIPLEX_LLM_LITERATURE=<model-name>
SCIPLEX_LLM_METHOD=<model-name>
SCIPLEX_LLM_REVIEW=<model-name>
SCIPLEX_LLM_WRITING=<model-name>

# Contact identity for polite academic API usage
RESEARCH_CONTACT_EMAIL=<your-email>

# Literature providers
ENABLE_OPENALEX=true
ENABLE_ARXIV=true
ENABLE_ZOTERO=false
PROVIDER_TIMEOUT_SECONDS=30
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_EMAIL=<your-email>
SEMANTIC_SCHOLAR_API_KEY=<your-api-key>
ZOTERO_USER_ID=<your-user-id>
ZOTERO_API_KEY=<your-api-key>
NCBI_API_KEY=<your-api-key>
